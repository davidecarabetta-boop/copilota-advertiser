# Copiare in .env (ignorato da git). In produzione i valori stanno in Secret Manager.

# Google Ads API (MCC SearchOn)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=        # id MCC senza trattini

# Meta Marketing API (utente di sistema con ads_read)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# GCP
GCP_PROJECT_ID=
BQ_DATASET=copilota
GOOGLE_APPLICATION_CREDENTIALS=      # percorso al json del service account, fuori dal repo

# Account pilota per lo smoke test
PILOT_GOOGLE_CUSTOMER_ID=
PILOT_META_AD_ACCOUNT_ID=            # formato act_<id>
